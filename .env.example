# Every variable the apps read, with no values.
# Local development: copy to apps/web/.env.local and fill in.

# --- Required ---
# Postgres connection string. Any Postgres works; on Neon use the pooled string.
DATABASE_URL=
# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app, no trailing slash. Local: http://localhost:3000
BETTER_AUTH_URL=

# --- Sign-in: at least one ---
# GitHub OAuth app or GitHub App. Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client. Callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 to allow email and password sign-in for the seeded demo account. Never in production.
COPPER_DEMO_LOGIN=

# --- Mode ---
# simple (default): pageviews arrive at /api/e and are buffered in this process.
# edge: pageviews arrive at the Cloudflare Worker in apps/ingest.
COPPER_MODE=
# Edge mode only: the Worker's URL and the secret it shares with this app.
INGEST_URL=
INGEST_SECRET=
# Edge mode only: the Worker sends this to /api/revalidate after each flush.
REVALIDATE_SECRET=

# --- Optional ---
# Share the session cookie across subdomains, e.g. .example.com
COOKIE_DOMAIN=
# Set to 1 to report the database query count at /api/health
COPPER_DEBUG=
